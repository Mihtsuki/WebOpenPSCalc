# Reference nginx site config — copy to /etc/nginx/sites-available/openpscalc
# on the EC2 box during one-time setup, edit server_name/root, then:
#   sudo ln -s /etc/nginx/sites-available/openpscalc /etc/nginx/sites-enabled/openpscalc
#   sudo rm -f /etc/nginx/sites-enabled/default
#   sudo nginx -t && sudo systemctl reload nginx

server {
    listen 80;
    server_name _;  # replace with your domain or EC2 public DNS

    root /home/ubuntu/openpscalc/frontend/dist;  # match EC2_DEPLOY_PATH
    index index.html;

    location /api/ {
        proxy_pass http://127.0.0.1:4000/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Exact-match proxies for the two stats API endpoints. The /stats page
    # itself falls through to the SPA via the / fallback below.
    location = /stats/ping {
        proxy_pass http://127.0.0.1:4000/stats/ping;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /stats/data {
        proxy_pass http://127.0.0.1:4000/stats/data;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # The SPA owns exactly two routes (/ and /stats — see App.tsx). Everything
    # else that isn't a real file is a genuine 404.
    #
    # It used to be `try_files $uri /index.html` for ALL paths, which answered
    # any URL — stale links, typos, probe traffic — with 200 and the app shell.
    # Google files those as soft 404s, and they show up in Search Console as
    # "not indexed" pages that don't exist. A 404 costs nothing and says so.
    location = / {
        try_files /index.html =404;
    }

    location = /stats {
        try_files /index.html =404;
    }

    location / {
        try_files $uri =404;
    }

    # Branded 404 (generated by scripts/gen-guides.mjs), served with a real 404
    # status so crawlers treat it as one.
    error_page 404 /404.html;
    location = /404.html {
        internal;
    }
}
